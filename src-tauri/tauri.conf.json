{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Projeção Financeira",
  "version": "../package.json",
  "identifier": "io.github.mizerski.projecaofinanceira",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Projeção Financeira",
        "width": 1440,
        "height": 900,
        "minWidth": 400,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Mizerski",
    "category": "Finance",
    "shortDescription": "Controle e projeção financeira dia a dia",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"]
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "COLE_AQUI_A_CHAVE_PUBLICA",
      "endpoints": [
        "https://github.com/Mizerski/finance-sheet/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
